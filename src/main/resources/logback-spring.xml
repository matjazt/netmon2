<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>log/netmon2.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- daily rollover + size limit -->
            <fileNamePattern>log/netmon2.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <!-- max size of a single log file -->
            <maxFileSize>20MB</maxFileSize>

            <!-- how many days of logs to keep -->
            <maxHistory>30</maxHistory>

            <!-- total size cap for all logs -->
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Custom appender for database logging of network/device events -->
    <appender
        name="NETWORK_DB" class="com.matjazt.netmon2.config.NetworkLogAppender">
        <!-- No configuration needed - uses Spring beans -->
    </appender>

    <!-- Async wrapper to prevent database logging from blocking log threads -->
    <appender
        name="ASYNC_NETWORK_DB" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="NETWORK_DB" />
        <!-- Queue size for async processing -->
        <queueSize>512</queueSize>
        <!-- Disable level-based early discarding (messages are dropped only when the queue is
        completely full, see neverBlock) -->
        <discardingThreshold>0</discardingThreshold>
        <!-- Don't block caller if queue is full - drop messages instead -->
        <neverBlock>true</neverBlock>
    </appender>


    <!-- Buffered email appender - sends batched log emails -->
    <appender name="EMAIL"
        class="com.matjazt.netmon2.config.BufferedEmailAppender">
        <!-- No configuration needed - uses Spring beans -->
    </appender>

    <!-- Async wrapper for email appender to prevent blocking -->
    <appender
        name="ASYNC_EMAIL" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="EMAIL" />
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <root level="INFO">
        <appender-ref ref="ROLLING" />
        <appender-ref ref="ASYNC_NETWORK_DB" />
        <appender-ref ref="ASYNC_EMAIL" />
    </root>

</configuration>