{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gradle-bootRun-debug",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "bootRun",
                "--debug-jvm",
                "-x",
                "test",
                "--no-daemon"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "java",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^.*$"
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": "Listening for transport dt_socket at address: 5005"
                    }
                }
            ]
        }
    ]
}